# versions.env
# Fuente única de verdad de versiones del testbed CIB46. Todos los scripts de
# bootstrap/ leen de aquí (`source versions.env`), de modo que actualizar una
# versión se hace en un solo lugar y queda registrada para reproducibilidad.
#
# Las versiones coinciden con el stack declarado en el README de la tesis.

# --- Kubernetes / CNI --------------------------------------------------------
export K3S_VERSION="v1.28.5+k3s1"          # k3s (README: v1.28.5)
export CILIUM_VERSION="1.15.4"             # Cilium CNI (README: v1.15.4)
export CILIUM_CLI_VERSION="v0.16.7"        # cilium CLI (compatible con 1.15.x)
export HUBBLE_CLI_VERSION="v0.13.3"        # hubble CLI
export MULTUS_VERSION="v4.0.2"             # Multus CNI (plano N2 10.10.0.0/24)
export METRICS_SERVER_VERSION="v0.7.1"     # metrics-server (kubectl top)

# --- Núcleo 5G ---------------------------------------------------------------
export OPEN5GS_CHART="towards5gs/open5gs"  # chart Helm towards5gs-helm
export OPEN5GS_CHART_VERSION="2.2.4"       # AJUSTAR al que usaste (Open5GS 2.7)
export TOWARDS5GS_REPO="https://raw.githubusercontent.com/Orange-OpenSource/towards5gs-helm/main/repo/"

# --- Identidad ---------------------------------------------------------------
export SPIRE_VERSION="1.9.0"               # SPIRE server/agent (README: v1.9.0)
export SPIRE_TRUST_DOMAIN="cib46.5gcore.local"
export SPIRE_CLUSTER_NAME="cib46-testbed"

# --- RAN simulada ------------------------------------------------------------
export UERANSIM_VERSION="v3.2.6"           # UERANSIM (README: v3.2.6)
# Imagen UERANSIM (AJUSTAR al registry/imagen que uses; pinnea por digest):
export UERANSIM_IMAGE="towards5gs/ueransim-gnb:v3.2.6"

# --- Imágenes de utilidad (PINNEAR POR DIGEST, no :latest) -------------------
# Obtén el digest con: docker buildx imagetools inspect nicolaka/netshoot:v0.13
export NETSHOOT_IMAGE="nicolaka/netshoot:v0.13"   # RM-12: evita :latest

# --- Parámetros de red del testbed ------------------------------------------
export PLMN_MCC="999"
export PLMN_MNC="70"
export NS_CP="5g-cp"
export NS_RAN="5g-ran"
export NS_UP="5g-up"
export N2_SUBNET="10.10.0.0/24"            # red Multus para N2 (gnb.yaml)
export N2_GNB_IP="10.10.0.20"

# --- Topología (AJUSTAR a tus VMs) ------------------------------------------
# IP del nodo master (para KubeProxyReplacement de Cilium: k8sServiceHost).
export K8S_API_HOST="${K8S_API_HOST:-127.0.0.1}"
export K8S_API_PORT="${K8S_API_PORT:-6443}"
